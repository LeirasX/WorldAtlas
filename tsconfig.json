{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "strict": true, "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
