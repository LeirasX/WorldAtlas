{
  "name": "worldatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode public",
    "build:web": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri",
    "build:native": "tsc --noEmit && vite build --mode native",
    "test:browser": "npm run build:web && playwright test",
    "build:local": "tsc --noEmit && vite build --mode local"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "lucide-react": "0.468.0",
    "papaparse": "5.7.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3",
    "vite": "6.4.2"
  }
}
